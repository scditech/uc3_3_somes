      "memory": 1024
    }
  },
  "tags": [
    "SHMU",
    "Calibration",
    "PVOUT"
  ],
  "style": {
    "node_label": "SHMÚ Calibration",
    "node_type": "default",
    "node_style": {
      "backgroundColor": "#ebebeb"
    },
    "useIcon": true,
    "icon_class_name": "fa-solid:crosshairs",
    "iconStyle": {
      "cursor": "pointer"
    }
  }
}
